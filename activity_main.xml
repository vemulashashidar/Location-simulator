<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Location Simulator" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Set a mock GPS location for testing apps on this device." android:textSize="15sp" android:textColor="#666666" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/mockStatus" android:text="Status: Stopped" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/latitude" android:hint="Latitude (e.g. 53.3498)" android:inputType="numberDecimal|numberSigned" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/longitude" android:hint="Longitude (e.g. -6.2603)" android:inputType="numberDecimal|numberSigned" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/interval" android:hint="Update interval (seconds, default 1)" android:inputType="number" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/startButton" android:text="START MOCK LOCATION" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/stopButton" android:text="STOP MOCK LOCATION" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/settingsButton" android:text="OPEN MOCK LOCATION SETTINGS" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/help" android:text="\nSetup:\n1. Open Developer options on your phone.\n2. Select Location Simulator as the mock location app.\n3. Enter coordinates and tap Start.\n\nUse only for legitimate testing and development. Some apps can detect mock locations." android:textSize="14sp" android:textColor="#444444" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
